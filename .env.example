# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── AI providers (report + revelation generation) ──────────────
MOONSHOT_API_KEY=         # primary provider
ANTHROPIC_API_KEY=        # backup provider (optional)

# ── Admin dashboard (/admin) ───────────────────────────────────
ADMIN_PASSWORD=           # change this — default is "2026"
