# ── Database ───────────────────────────────────────────────────
# Supabase Postgres — use the TRANSACTION POOLER connection string (port 6543)
# Supabase dashboard → Connect → Transaction pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── AI providers (report + revelation generation) ──────────────
MOONSHOT_API_KEY=         # primary provider
ANTHROPIC_API_KEY=        # backup provider (optional)

# ── Admin dashboard (/admin) ───────────────────────────────────
ADMIN_PASSWORD=           # change this — default is "2026"
