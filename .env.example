# ── Database ───────────────────────────────────────────────────
# Supabase Postgres transaction pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# ── Public origin ──────────────────────────────────────────────
# Used to build Stripe success and cancellation URLs.
PUBLIC_APP_URL=https://revela.love

# ── Secure Stripe Checkout ─────────────────────────────────────
# Secret server key. Never expose it through a VITE_ or other public variable.
STRIPE_SECRET_KEY=sk_live_...

# ── AI providers for paid deep-reading generation ──────────────
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-32k
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Optional illustration provider ─────────────────────────────
GEMINI_API_KEY=

# ── Admin dashboard (/admin) ───────────────────────────────────
ADMIN_PASSWORD=replace-with-a-long-random-password
